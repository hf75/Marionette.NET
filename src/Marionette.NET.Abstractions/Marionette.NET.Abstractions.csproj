<!--
  TreatAsLocalProperty — Phase 4.2 restored from Spike B.

  When an adopter publishes a sample with `dotnet publish -p:PublishAot=true`,
  MSBuild propagates the property as a *global* into every transitively
  referenced project, including this multi-target Abstractions assembly. On
  the netstandard2.0 leg of this multi-target the propagated PublishAot=true
  triggers NETSDK1207 ("Ahead-of-time compilation is not supported for the
  target framework"). TreatAsLocalProperty on the <Project> element tells
  MSBuild to *unwind* the listed globals at this project boundary so the
  property-group overrides below can pin them to false for the netstandard2.0
  leg. Same pattern applies to PublishTrimmed / IsTrimmable / IsAotCompatible.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;IsAotCompatible;PublishTrimmed;IsTrimmable">

  <PropertyGroup>
    <!--
      Multi-target rationale (Phase 1.a, per PHASE0_FINDINGS implication 2):
        - netstandard2.0: max compatibility for downstream consumers (older project SDKs).
        - net10.0       : modern TFM gets IsAotCompatible / IsTrimmable natively, lights up
                          the trim/AOT analyzer pack at compile time.
      The net10.0 build is the one a contemporary WPF/Avalonia/WinUI/Uno/MAUI app picks up;
      the netstandard2.0 build is the legacy fallback. Same source, two outputs.
    -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>Marionette</RootNamespace>
    <AssemblyName>Marionette.NET.Abstractions</AssemblyName>
    <Description>Attribute and stub surface for Marionette.NET. Always referenced; carries no runtime code.</Description>
  </PropertyGroup>

  <!--
    IsTrimmable / IsAotCompatible only ship in the analyzer pack from net8.0 upward.
    Setting either on netstandard2.0 raises NETSDK1212 / NETSDK1210, which becomes a build
    error under TreatWarningsAsErrors. Gate them on net8.0+ via IsTargetFrameworkCompatible.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Phase 4.2 explicit unwind: when the parent publish propagates PublishAot=true,
    pin the netstandard2.0 leg to false. The TreatAsLocalProperty above lets these
    project-level values win against the propagated globals.
  -->
  <PropertyGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <PublishTrimmed>false</PublishTrimmed>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>


  <!--
    The Runtime assembly populates Marionette.Ai.TriggerHook / ScheduleTriggerHook at
    startup. Those fields are internal so the public surface stays one-way; this grants
    the runtime visibility without exposing them to user code.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Marionette.NET.Runtime" />
  </ItemGroup>

</Project>

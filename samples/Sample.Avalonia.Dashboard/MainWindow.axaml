<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sample.Avalonia.Dashboard"
        xmlns:m="using:Sample.Avalonia.Dashboard.Models"
        x:Class="Sample.Avalonia.Dashboard.MainWindow"
        x:DataType="vm:DashboardViewModel"
        Title="Marionette Avalonia Dashboard"
        Width="640" Height="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Marionette Dashboard"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="An MCP-controllable Avalonia reference sample. Try it: claude mcp add it, then ask Claude to upsert a metric."
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Counter strip -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="METRICS"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding MetricCount}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TOTAL"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Total, StringFormat='{}{0:0.##}'}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="STATUS"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="StatusBadge"
                               FontSize="20"
                               FontWeight="SemiBold">
                        <TextBlock.Text>
                            <Binding Path="IsPaused">
                                <Binding.Converter>
                                    <vm:BoolToTextConverter TrueText="PAUSED" FalseText="LIVE" />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Text>
                        <TextBlock.Foreground>
                            <Binding Path="IsPaused">
                                <Binding.Converter>
                                    <vm:BoolToBrushConverter TrueBrush="#DA373C" FalseBrush="#23A559" />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add row -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*,Auto,Auto" Margin="0,0,0,12">
            <TextBox x:Name="NameTextBox"
                     Grid.Column="0"
                     Watermark="metric name"
                     Margin="0,0,8,0" />
            <TextBox x:Name="ValueTextBox"
                     Grid.Column="2"
                     Watermark="value"
                     Margin="0,0,8,0" />
            <TextBox x:Name="UnitTextBox"
                     Grid.Column="3"
                     Watermark="unit"
                     Width="80"
                     Margin="0,0,8,0" />
            <Button x:Name="UpsertButton"
                    Grid.Column="4"
                    Content="Upsert"
                    Click="UpsertButton_Click" />
        </Grid>

        <!-- Items list -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer>
                <ItemsControl x:Name="MetricsItemsControl"
                              ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="m:Metric">
                            <Border BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TrendGlyph}"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               Width="20"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Value, StringFormat='{}{0:0.##}'}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Unit}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <Button Grid.Column="4"
                                            Content="Remove"
                                            Tag="{Binding Name}"
                                            Click="RemoveMetricButton_Click"
                                            Padding="8,4"
                                            FontSize="11" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer actions -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding LastUpdatedMetric, StringFormat='Last updated: {0}', FallbackValue='Last updated: (none)', TargetNullValue='Last updated: (none)'}" />
            <Button Grid.Column="1"
                    Content="Refresh"
                    Click="RefreshButton_Click"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Content="Toggle Pause"
                    Click="TogglePauseButton_Click"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    Content="Reset all"
                    Click="ResetAllButton_Click" />
        </Grid>

        <!-- Bottom hint -->
        <TextBlock Grid.Row="5"
                   Margin="0,16,0,0"
                   FontSize="10"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Text="Marionette root: DashboardViewModel  -  5 callables, 4 observables (3 watchable), 2 events" />
    </Grid>
</Window>

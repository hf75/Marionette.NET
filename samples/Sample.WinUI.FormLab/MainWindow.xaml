<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sample.WinUI.FormLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Sample.WinUI.FormLab"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="Marionette WinUI FormLab">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Marionette FormLab"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="An MCP-controllable WinUI 3 settings form. Try it: claude mcp add it, then ask Claude to set the name, age, and submit."
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NAME" FontSize="10" Opacity="0.6" />
                    <TextBlock x:Name="NameStatusText"
                               Text="{x:Bind ViewModel.Name, Mode=OneWay, FallbackValue=' '}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AGE" FontSize="10" Opacity="0.6" />
                    <TextBlock x:Name="AgeStatusText"
                               Text="{x:Bind ViewModel.Age, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SUBMITTED" FontSize="10" Opacity="0.6" />
                    <TextBlock x:Name="SubmittedStatusText"
                               Text="{x:Bind ViewModel.HasSubmitted, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="14">

                <!-- Name TextBox -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Display name" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="NameBox"
                             automation:AutomationProperties.AutomationId="NameBox"
                             PlaceholderText="Your name"
                             Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                             TextChanged="NameBox_TextChanged" />
                </StackPanel>

                <!-- Age NumberBox -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Age" FontSize="12" Opacity="0.7" />
                    <NumberBox x:Name="AgeBox"
                               automation:AutomationProperties.AutomationId="AgeBox"
                               Minimum="0"
                               Maximum="150"
                               SmallChange="1"
                               LargeChange="10"
                               Value="{x:Bind ViewModel.Age, Mode=OneWay}"
                               ValueChanged="AgeBox_ValueChanged" />
                </StackPanel>

                <!-- Notifications ToggleSwitch -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Notifications" FontSize="12" Opacity="0.7" />
                    <ToggleSwitch x:Name="NotificationsToggle"
                                  automation:AutomationProperties.AutomationId="NotificationsToggle"
                                  OnContent="Enabled"
                                  OffContent="Disabled"
                                  IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=OneWay}"
                                  Toggled="NotificationsToggle_Toggled" />
                </StackPanel>

                <!-- Theme ComboBox -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Theme" FontSize="12" Opacity="0.7" />
                    <ComboBox x:Name="ThemeBox"
                              automation:AutomationProperties.AutomationId="ThemeBox"
                              SelectedItem="{x:Bind ViewModel.Theme, Mode=OneWay}"
                              SelectionChanged="ThemeBox_SelectionChanged"
                              MinWidth="220">
                        <x:String>Default</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button x:Name="ResetButton"
                    automation:AutomationProperties.AutomationId="ResetButton"
                    Content="Reset"
                    Click="ResetButton_Click" />
            <Button x:Name="SubmitButton"
                    automation:AutomationProperties.AutomationId="SubmitButton"
                    Content="Submit"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SubmitButton_Click" />
        </StackPanel>

    </Grid>
</Window>

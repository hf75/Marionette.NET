<Application x:Class="Sample.Wpf.NeonControlCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
            Synthwave / "neon mission control" palette. Deep midnight purple
            backgrounds with hot magenta + cyan + lime accents. Designed to
            look spectacular in screenshots — the vibe is "1986 cyberpunk
            terminal in 2026 .NET".
        -->

        <!-- Background gradient: vertical midnight purple to deep navy -->
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0A0420" Offset="0" />
            <GradientStop Color="#FF180A3C" Offset="0.4" />
            <GradientStop Color="#FF0E0524" Offset="1" />
        </LinearGradientBrush>

        <!-- Panel: translucent dark over the gradient bg -->
        <SolidColorBrush x:Key="PanelBrush" Color="#CC1A0F3F" />
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#FF110826" />
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#FF24135A" />

        <!-- Neon accents -->
        <SolidColorBrush x:Key="MagentaBrush" Color="#FFFF2EC8" />
        <SolidColorBrush x:Key="CyanBrush" Color="#FF1AF3FF" />
        <SolidColorBrush x:Key="LimeBrush" Color="#FFB8FF1F" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#FFFFA61A" />
        <SolidColorBrush x:Key="HotPinkBrush" Color="#FFFF4F8A" />

        <!-- Text -->
        <SolidColorBrush x:Key="TextBrush" Color="#FFE5E2F2" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#FF9C97B5" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6B6388" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF3D5A" />

        <!-- Glowing magenta border -->
        <LinearGradientBrush x:Key="NeonBorderMagenta" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFF2EC8" Offset="0" />
            <GradientStop Color="#FF8B1AFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NeonBorderCyan" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1AF3FF" Offset="0" />
            <GradientStop Color="#FF1A8BFF" Offset="1" />
        </LinearGradientBrush>

        <!-- Text styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFFF2EC8" BlurRadius="20" ShadowDepth="0" Opacity="0.9" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LimeBrush}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFB8FF1F" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Neon button: glowing border, dark fill, accent on hover -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFF2EC8" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyanButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF1AF3FF" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LimeButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Foreground" Value="{StaticResource LimeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFB8FF1F" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glowing panel border -->
        <Style x:Key="GlowPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NeonBorderMagenta}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFFF2EC8" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlowPanelCyan" TargetType="Border" BasedOn="{StaticResource GlowPanel}">
            <Setter Property="BorderBrush" Value="{StaticResource NeonBorderCyan}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF1AF3FF" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

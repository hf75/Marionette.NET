<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ProbeIl</RootNamespace>
    <AssemblyName>ProbeIl</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Standalone tool: do not inherit Directory.Build.props' TreatWarningsAsErrors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Keep this tool out of the solution; it's an ad-hoc Phase-0 utility. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>

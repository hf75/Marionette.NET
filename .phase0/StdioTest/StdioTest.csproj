<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike C stdio handshake test harness. Spawns Sample.Wpf.StripeProbe.exe with
    'mcp headless' flags and exchanges JSON-RPC frames over its stdin/stdout.
    Outside the solution intentionally (Phase 0 utility, not shipping code).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StdioTest</RootNamespace>
    <AssemblyName>StdioTest</AssemblyName>
    <!-- The Spike A baseline TWAE=true is overkill for a one-off probe; relax. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
